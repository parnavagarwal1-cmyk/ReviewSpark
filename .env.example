# ReviewSpark Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Public (safe to expose in browser) ──────────────────────────────────────

# The public base URL of your app (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project settings > API

# Public URL of your Supabase project
SUPABASE_URL=https://your-project.supabase.co

# Service role key (SECRET — server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin Authentication ──────────────────────────────────────────────────────
# Generate a bcrypt hash of your admin password:
#   npm run setup:admin
# Note: Dollar signs must be escaped as \$ so Next.js doesn't treat them as variable expansions.
ADMIN_PASSWORD_HASH=\$2b\$12\$...your.bcrypt.hash.here

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key (SECRET — server-side only)
OPENAI_API_KEY=sk-...your-openai-key-here

# Optional: override the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Daily AI cost cap in USD (default: $10.00). Requests are rejected when exceeded.
AI_DAILY_COST_CAP_USD=10.00

# ── Google Places API ─────────────────────────────────────────────────────────
# Required for automatic business data resolution.
# Create an API key in Google Cloud Console > APIs & Services > Credentials.
# Enable: Places API (New)
# Restrict the key to: Places API, server IP addresses only.
# If not set, business data must be entered manually.
GOOGLE_PLACES_API_KEY=AIza...your-google-api-key-here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# HMAC secret for IP address hashing (change from default in production!)
IP_HASH_SECRET=change-this-to-a-random-string-in-production
